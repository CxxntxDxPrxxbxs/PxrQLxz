local StatsCard = CombatSection:NewControlCard({
    Title = "Combat Stats",
    Description = "Live combat performance overview",
    Icon = "activity",
    Status = "Idle",
    Badge = "Beta",
    Value = "0 kills",
    Footer = "Updates every second while Auto Kill is active",
    Collapsible = true,
    DefaultCollapsed = false,
    Action = {
        Icon = "refresh-cw",
        Callback = function()
            StatsCard:SetValue("0 kills")
            StatsCard:SetStatus("Reset")
        end,
    },
})

StatsCard:NewToggle({
    Title = "Show Kill Feed",
    Default = true,
    Flag = "ShowKillFeed",
    Callback = function(value)
        print("ShowKillFeed:", value)
    end,
})

local killCount = 0
task.spawn(function()
    while true do
        task.wait(1)
        if autoKillToggle.GetValue() then
            killCount += 1
            StatsCard:SetValue(tostring(killCount) .. " kills")
            StatsCard:SetStatus("Active")
        end
    end
end)

