        end)

        local half = plot.Size / 2
        local function fallback(cf)
            local rel = plot.CFrame:PointToObjectSpace(cf.Position)
            return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
        end

        return function(cf)
            if envCheck then
