do
    local Farm = Tabs.Farm

    local CHEST_POSITION = Vector3.new(-53.337, -358.568, 9490.461)
    local CHEST_WAIT = 3
    local STAGE_TIMEOUT = 8

    local TP_DWELL = 0.5
    local TP_JITTER = 2
    local TP_STEP = 40

    local CaveFarm = {
        enabled = false,
        mode = nil,
        speed = 400,
        token = 0,
        noclipConn = nil,
    }

    local Toggles = {}

    local function getRoot()
        local character = LocalPlayer.Character
        return character and character:FindFirstChild("HumanoidRootPart"), character
    end

    local function isCharacterAlive(character)
        if not character or LocalPlayer.Character ~= character then
            return false
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        return humanoid ~= nil and humanoid.Health > 0
    end

    local function getDarknessPart(index)
        local boatStages = workspace:FindFirstChild("BoatStages")
        local normal = boatStages and boatStages:FindFirstChild("NormalStages")
        local stage = normal and normal:FindFirstChild("CaveStage" .. index)
        if not stage then
            return nil
        end
        local part = stage:FindFirstChild("DarknessPart", true)
        if part and part:IsA("BasePart") then
            return part
        end
        return nil
    end

    local function startNoclip()
        if CaveFarm.noclipConn then
            return
        end
        CaveFarm.noclipConn = RunService.Stepped:Connect(function()
            local character = LocalPlayer.Character
            if not character then
                return
            end
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
    end

    local function stopFarm()
        CaveFarm.enabled = false
        CaveFarm.mode = nil
        CaveFarm.token = CaveFarm.token + 1

        if CaveFarm.noclipConn then
            CaveFarm.noclipConn:Disconnect()
            CaveFarm.noclipConn = nil
        end

        local root, character = getRoot()
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            pcall(function()
                humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
            end)
        end
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end

    local function startFarm(key, style, finish)
        CaveFarm.token = CaveFarm.token + 1
        local token = CaveFarm.token
        CaveFarm.enabled = true
        CaveFarm.mode = key
        startNoclip()

        local function active()
            return CaveFarm.enabled and CaveFarm.token == token and isAlive()
        end

        local function freeze(character)
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end

        local function waitForSpawn(oldCharacter, delay)
            while active() do
                local root, character = getRoot()
                if root and character ~= oldCharacter and isCharacterAlive(character) then
                    break
                end
                task.wait(0.2)
            end
            if active() then
                task.wait(delay or 1.5)
            end
        end

        local function waitForStage(index, character)
            local deadline = os.clock() + STAGE_TIMEOUT
            while active() do
                local part = getDarknessPart(index)
                if part then
                    return part
                end
                if os.clock() > deadline or not isCharacterAlive(character) then
                    return nil
                end
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.PlatformStand = true
                end
                freeze(character)
                task.wait(0.1)
            end
            return nil
        end

        local function flyTo(getPosition, character)
            while active() do
                local position = getPosition()
                if not position then
                    return "ok"
                end

                local dt = RunService.Heartbeat:Wait()

                if not isCharacterAlive(character) then
                    return "died"
                end

                local root = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChildOfClass("Humanoid")

                if root and humanoid then
                    humanoid.PlatformStand = true

                    local diff = position - root.Position
                    local distance = diff.Magnitude
                    local step = CaveFarm.speed * dt

                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero

                    if distance <= step then
                        root.CFrame = CFrame.new(position) * root.CFrame.Rotation
                        return "ok"
                    end

                    root.CFrame = CFrame.new(root.Position + diff.Unit * step) * root.CFrame.Rotation
                end
            end
            return "stopped"
        end

        local function tpTo(getPosition, character)
            local frame = 0
            local dwellUntil = nil

            while active() do
                local position = getPosition()
                if not position then
                    return "ok"
                end

                RunService.Heartbeat:Wait()

                if not isCharacterAlive(character) then
                    return "died"
                end

                local root = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChildOfClass("Humanoid")

                if root and humanoid then
                    humanoid.PlatformStand = true
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero

                    local diff = position - root.Position

                    if diff.Magnitude > TP_STEP and not dwellUntil then
                        root.CFrame = CFrame.new(root.Position + diff.Unit * TP_STEP) * root.CFrame.Rotation
                    else
                        if not dwellUntil then
                            local pingSeconds = Util.getPing() / 1000
                            dwellUntil = os.clock() + TP_DWELL + pingSeconds * 2
                        end

                        frame = frame + 1
                        local angle = frame * 1.7
                        local offset = Vector3.new(
                            math.sin(angle) * TP_JITTER,
                            math.sin(angle * 0.7) * TP_JITTER,
                            math.cos(angle) * TP_JITTER
                        )
                        root.CFrame = CFrame.new(position + offset) * root.CFrame.Rotation

                        if os.clock() >= dwellUntil then
                            return "ok"
                        end
                    end
                end
            end
            return "stopped"
        end

        local function moveTo(getPosition, character)
            if style == "tp" then
                return tpTo(getPosition, character)
            end
            return flyTo(getPosition, character)
        end

        local function holdAt(position, seconds, character)
            local untilTime = os.clock() + seconds
            while active() and os.clock() < untilTime do
                RunService.Heartbeat:Wait()
                if LocalPlayer.Character ~= character then
                    return
                end
                local root = getRoot()
                if root then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.CFrame = CFrame.new(position) * root.CFrame.Rotation
                end
            end
        end

        local function killCharacter(character)
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.PlatformStand = false
                humanoid.Health = 0
            elseif character then
                pcall(function()
                    character:BreakJoints()
                end)
            end
        end

        local function stopAll()
            stopFarm()
            for _, toggle in pairs(Toggles) do
                pcall(function()
                    toggle:Set(false)
                end)
            end
        end

        task.spawn(function()
            while active() do
                waitForSpawn(nil, 1.5)
                if not active() then
                    return
                end

                local _, character = getRoot()
                local result = "ok"

                for index = 1, 10 do
                    local target = waitForStage(index, character)

                    if not active() then
                        return
                    end
                    if not isCharacterAlive(character) then
                        result = "died"
                        break
                    end
                    if not target then
                        result = (index == 1) and "nostages" or "missing"
                        break
                    end

                    local lastPosition = target.Position
                    local flight = moveTo(function()
                        local part = getDarknessPart(index)
                        if part then
                            lastPosition = part.Position
                        end
                        return lastPosition
                    end, character)

                    if flight == "stopped" then
                        return
                    end
                    if flight == "died" then
                        result = "died"
                        break
                    end
                end

                if not active() then
                    return
                end

                if result == "nostages" then
                    Util.notify(L("farm_section"), L("farm_missing"), "triangle-alert")
                    stopAll()
                    return
                elseif result == "died" then
                    waitForSpawn(character, 1.5)
                elseif result == "missing" then
                    killCharacter(character)
                    waitForSpawn(character, 1.5)
                else
                    if finish == "chest" then
                        local flight = moveTo(function()
                            return CHEST_POSITION
                        end, character)

                        if flight == "stopped" then
                            return
                        end
                        if flight == "ok" then
                            holdAt(CHEST_POSITION, CHEST_WAIT, character)
                        end
                        if not active() then
                            return
                        end
                    end

                    if isCharacterAlive(character) then
                        killCharacter(character)
                    end
                    waitForSpawn(character, 1.5)
                end
            end
        end)
    end

    local function setMode(key, style, finish, state)
        if state then
            if CaveFarm.mode and CaveFarm.mode ~= key then
                stopFarm()
            end
            for otherKey, toggle in pairs(Toggles) do
                if otherKey ~= key then
                    pcall(function()
                        toggle:Set(false)
                    end)
                end
            end
            startFarm(key, style, finish)
        elseif CaveFarm.mode == key then
            stopFarm()
        end
    end

    Farm:Section({ Title = L("farm_section") })

    Farm:Input({
        Title = L("farm_speed_input"),
        Placeholder = L("farm_speed_ph"),
        Value = "",
        Callback = function(text)
            local n = tonumber(text)
            if n then
                CaveFarm.speed = math.clamp(n, 10, 1000)
            end
        end,
    })

    Toggles.fly_normal = Farm:Toggle({
        Title = L("farm_cave"),
        Desc = L("farm_cave_desc"),
        Value = false,
        Callback = function(state)
            setMode("fly_normal", "fly", "normal", state)
        end,
    })
    Util.register("farm_cave_stages", Toggles.fly_normal)

    Toggles.fly_chest = Farm:Toggle({
        Title = L("farm_chest"),
        Desc = L("farm_chest_desc"),
        Value = false,
        Callback = function(state)
            setMode("fly_chest", "fly", "chest", state)
        end,
    })
    Util.register("farm_chest_stages", Toggles.fly_chest)

    Farm:Section({ Title = L("farm_tp_section") })

    Toggles.tp_normal = Farm:Toggle({
        Title = L("farm_tp_stages"),
        Desc = L("farm_tp_stages_desc"),
        Value = false,
        Callback = function(state)
            setMode("tp_normal", "tp", "normal", state)
        end,
    })
    Util.register("farm_tp_stages", Toggles.tp_normal)

    Toggles.tp_chest = Farm:Toggle({
        Title = L("farm_tp_chest"),
        Desc = L("farm_tp_chest_desc"),
        Value = false,
        Callback = function(state)
            setMode("tp_chest", "tp", "chest", state)
        end,
    })
    Util.register("farm_tp_chest", Toggles.tp_chest)

    task.spawn(function()
        while isAlive() do
            task.wait(1)
        end
        pcall(stopFarm)
    end)
end

do
    local Data = Tabs.Data

    local HOUR_SECONDS = 3600
    local DAY_SECONDS = 86400
    local MIN_SECONDS_FOR_RATE = 10
    local WEBHOOK_COLOR = 0x170158
    local WEBHOOK_IMAGE = "https://raw.githubusercontent.com/Mystery-Center/Mystery-Media/main/Mystery%20Notificaciones%20Imagen.png"

    local Tracker = {
        running = false,
        elapsed = 0,
        gained = 0,
        lastGold = 0,
        lastTick = 0,
        hour = { elapsed = 0, gained = 0, done = false },
        day = { elapsed = 0, gained = 0, done = false },
        autoSend = false,
        sending = false,
    }

    local webhookUrl = ""

    local ABBREVIATIONS = {
        { 1e12, "T" },
        { 1e9, "B" },
        { 1e6, "M" },
        { 1e3, "K" },
    }

    local function withCommas(number)
        local text = string.format("%d", math.floor(number))
        local reversed = text:reverse():gsub("(%d%d%d)", "%1,")
        local result = reversed:reverse():gsub("^,", "")
        return result
    end

    local function abbreviate(number)
        for _, entry in ipairs(ABBREVIATIONS) do
            if number >= entry[1] then
                local value = math.floor(number / entry[1] * 100) / 100
                local text = string.format("%.2f", value):gsub("%.?0+$", "")
                return text .. entry[2]
            end
        end
        return nil
    end

    local function formatGold(number)
        number = math.floor(number or 0)
        local short = abbreviate(number)
        if short then
            return withCommas(number) .. " [" .. short .. "]"
        end
        return withCommas(number)
    end

    local function getGoldObject()
        local data = LocalPlayer:FindFirstChild("Data")
        return data and data:FindFirstChild("Gold")
    end

    local function getRates()
        if Tracker.elapsed < MIN_SECONDS_FOR_RATE then
            return nil
        end
        local perHour = Tracker.gained / Tracker.elapsed * 3600
        return {
            hour = perHour,
            day = perHour * 24,
            week = perHour * 24 * 7,
            month = perHour * 24 * 30,
        }
    end

    local function buildCalcText()
        local rates = getRates()
        local lines = {}
        if rates then
            table.insert(lines, L("data_per_hour") .. ": " .. formatGold(rates.hour))
            table.insert(lines, L("data_per_day") .. ": " .. formatGold(rates.day))
            table.insert(lines, L("data_per_week") .. ": " .. formatGold(rates.week))
            table.insert(lines, L("data_per_month") .. ": " .. formatGold(rates.month))
        else
            table.insert(lines, L("data_calculating"))
        end
        table.insert(lines, "")
        table.insert(lines, L("data_approx"))
        return table.concat(lines, "\n")
    end

    local function buildGainedText()
        return table.concat({
            L("data_gained") .. ": " .. formatGold(Tracker.gained),
            L("data_elapsed") .. ": " .. Util.formatTime(Tracker.elapsed),
        }, "\n")
    end

    local function buildBlockText(block, limit)
        return table.concat({
            L("data_gained") .. ": " .. formatGold(block.gained),
            L("data_time") .. ": " .. Util.formatTime(block.elapsed) .. " / " .. Util.formatTime(limit),
            L("data_status") .. ": " .. (block.done and L("data_status_frozen") or L("data_status_counting")),
        }, "\n")
    end

    local function sendReport(kind)
        if Tracker.sending then
            return
        end

        if webhookUrl == "" or not webhookUrl:match("^https://") then
            Util.notify(L("data_webhook_section"), L("data_webhook_nourl"), "triangle-alert")
            return
        end

        local request = Logger.getRequest()
        if not request then
            Util.notify(L("error"), L("data_webhook_norequest"), "triangle-alert")
            return
        end

        Tracker.sending = true

        local titles = {
            manual = "Gold Report",
            hour = "1 Hour Completed",
            day = "1 Day Completed",
        }

        local rates = getRates()
        local lines = {
            "**Player**",
            "Username: " .. LocalPlayer.Name,
            "",
            "**Session**",
            "Elapsed: " .. Util.formatTime(Tracker.elapsed),
            "Gained = " .. formatGold(Tracker.gained),
            "",
            "**Estimated (approximate)**",
        }

        if rates then
            table.insert(lines, "Per hour = " .. formatGold(rates.hour))
            table.insert(lines, "Per day = " .. formatGold(rates.day))
            table.insert(lines, "Per week = " .. formatGold(rates.week))
            table.insert(lines, "Per month = " .. formatGold(rates.month))
        else
            table.insert(lines, "Not enough data yet")
        end

        table.insert(lines, "")
        table.insert(lines, "**1 Hour**")
        table.insert(lines, "Gained = " .. formatGold(Tracker.hour.gained) .. (Tracker.hour.done and " (frozen)" or " (counting)"))
        table.insert(lines, "")
        table.insert(lines, "**1 Day**")
        table.insert(lines, "Gained = " .. formatGold(Tracker.day.gained) .. (Tracker.day.done and " (frozen)" or " (counting)"))

        local payload = {
            username = Config.HubName,
            embeds = {
                {
                    title = titles[kind] or titles.manual,
                    description = table.concat(lines, "\n"),
                    color = WEBHOOK_COLOR,
                    image = { url = WEBHOOK_IMAGE },
                    footer = { text = "Mystery Hub • Gold Tracker" },
                    timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
                },
            },
        }

        local success = false
        local encodeOk, body = pcall(function()
            return HttpService:JSONEncode(payload)
        end)

        if encodeOk then
            local ok, response = pcall(function()
                return request({
                    Url = webhookUrl,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = body,
                })
            end)
            if ok then
                if type(response) == "table" then
                    local code = tonumber(response.StatusCode or response.Status)
                    success = code ~= nil and code >= 200 and code < 300
                else
                    success = true
                end
            end
        end

        Tracker.sending = false

        if success then
            Util.notify(L("data_webhook_section"), L("data_webhook_sent"), "check")
        else
            Util.notify(L("error"), L("data_webhook_failed"), "triangle-alert")
        end
    end

    local function advanceBlock(block, limit, dt, delta, kind)
        if block.done then
            return
        end

        block.elapsed = block.elapsed + dt
        block.gained = block.gained + delta

        if block.elapsed >= limit then
            block.elapsed = limit
            block.done = true
            if Tracker.autoSend then
                task.spawn(sendReport, kind)
            end
        end
    end

    local function trackerTick()
        local goldObject = getGoldObject()
        if not goldObject then
            return
        end

        local now = os.clock()
        local dt = now - Tracker.lastTick
        Tracker.lastTick = now

        local value = goldObject.Value
        local delta = math.max(value - Tracker.lastGold, 0)
        Tracker.lastGold = value

        Tracker.elapsed = Tracker.elapsed + dt
        Tracker.gained = Tracker.gained + delta

        advanceBlock(Tracker.hour, HOUR_SECONDS, dt, delta, "hour")
        advanceBlock(Tracker.day, DAY_SECONDS, dt, delta, "day")
    end

    local function resetTracker()
        Tracker.elapsed = 0
        Tracker.gained = 0
        Tracker.hour = { elapsed = 0, gained = 0, done = false }
        Tracker.day = { elapsed = 0, gained = 0, done = false }

        local goldObject = getGoldObject()
        Tracker.lastGold = goldObject and goldObject.Value or 0
        Tracker.lastTick = os.clock()
    end

