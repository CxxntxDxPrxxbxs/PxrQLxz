                    saved.decoration = terrain.Decoration
                    terrain.Decoration = false
                end)
            end
        else
            local saved = Opt.globals
            if not saved then
                return
            end
            Opt.globals = nil

            pcall(function()
                if saved.quality ~= nil then
                    settings().Rendering.QualityLevel = saved.quality
