	function self.newSlider(name, desc, max, manageSlider, func, flag)
		local newSlider = reserved.Slider:Clone()
		hoverCard(newSlider)
		newSlider.Visible = true
		newSlider.Name = name
		newSlider.Parent = newTab
		newSlider.Title.Text = name
		newSlider.Description.Text = desc or ""
		local Mouse = LP:GetMouse()
		local Trigger = newSlider.ActualSlider.Trigger
		local Label = newSlider.ActualSlider.Title
		local Fill = newSlider.ActualSlider.Fill
		local Parent = newSlider.ActualSlider
		local perc = 0
		local MouseDown = false
		local function apply(p, fire)
			perc = math.clamp(p, 0, max)
			local scale = max == 0 and 0 or (perc / max)
			Label.Text = perc
			tween(Fill, 0.15, { Size = UDim2.fromScale(scale, 1) })
			if fire and func then
				if manageSlider == true then pcall(func, perc, Label) else pcall(func, perc) end
			end
		end
		local function Update()
			MouseDown = true
			repeat
				task.wait()
				local Percent = math.clamp((Mouse.X - Parent.AbsolutePosition.X) / Parent.AbsoluteSize.X, 0, 1)
				apply(math.round(Percent * max), true)
			until MouseDown == false
			onChanged()
		end
		Trigger.MouseButton1Down:Connect(Update)
		UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				MouseDown = false
			end
		end)
		registerFlag(flag, function() return perc end, function(v) apply(tonumber(v) or 0, true) end)
		return { Set = function(_, v) apply(tonumber(v) or 0, true) end }
	end

