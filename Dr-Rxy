    local function renderEsp()
        local doBox, doSkel, doTracer, doBox3 = flags.box, flags.skeleton, flags.tracers, flags.box3d

        if not doBox and next(boxStore) then
            for player in pairs(boxStore) do clearBox(player) end
        end
        if not doSkel and next(skelStore) then
            for player in pairs(skelStore) do clearSkel(player) end
        end
        if not doTracer and next(tracerStore) then
            for player in pairs(tracerStore) do clearTracer(player) end
        end
        if not doBox3 and next(box3Store) then
            for player in pairs(box3Store) do clearBox3(player) end
        end
        if not (doBox or doSkel or doTracer or doBox3) then
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local needCorners = doBox or doBox3
        local camCF = camera.CFrame
        local camPos, camLook = camCF.Position, camCF.LookVector
        local origin = doTracer and tracerOrigin(camera) or nil

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character, _, root = hasBody(player)

                if not character then
                    if doBox then clearBox(player) end
                    if doSkel then clearSkel(player) end
                    if doTracer then clearTracer(player) end
                    if doBox3 then clearBox3(player) end
                elseif (root.Position - camPos):Dot(camLook) <= 0 then
                    hideAll(player)
                else
                    local col = espColor(espRole(player))

                    local pts, okPts = nil, false
                    local bx1, by1, bx2, by2 = 0, 0, 0, 0
                    local allAhead = false

                    if needCorners then
                        local cf, size = charBounds(character)
                        if cf then
                            pts, okPts = {}, true
                            bx1, by1, bx2, by2 = math.huge, math.huge, -math.huge, -math.huge
                            local half = size * 0.5
                            local ahead = 0
                            for i = 1, 8 do
                                local c = CORNERS[i]
                                local v = camera:WorldToViewportPoint(
                                    cf:PointToWorldSpace(Vector3.new(c.X * half.X, c.Y * half.Y, c.Z * half.Z))
                                )
                                pts[i] = Vector2.new(v.X, v.Y)
                                if v.Z > 0 then
                                    ahead = ahead + 1
                                    if v.X < bx1 then bx1 = v.X end
                                    if v.X > bx2 then bx2 = v.X end
                                    if v.Y < by1 then by1 = v.Y end
                                    if v.Y > by2 then by2 = v.Y end
                                end
                            end
                            allAhead = (ahead == 8)
                            if ahead < 4 then
                                okPts = false
                            end
                            if okPts and ((bx2 - bx1) < 1 or (by2 - by1) < 1) then
                                okPts = false
                            end
                        end
                    end

                    if doBox then
                        local b = ensureBox(player)
                        if okPts then
                            local tl, tr = Vector2.new(bx1, by1), Vector2.new(bx2, by1)
                            local bl, br = Vector2.new(bx1, by2), Vector2.new(bx2, by2)
                            local segs = { { tl, tr }, { tr, br }, { br, bl }, { bl, tl } }
                            for i = 1, 4 do
                                local line = b[i]
                                line.From, line.To, line.Color, line.Visible = segs[i][1], segs[i][2], col, true
                            end
                        else
                            for _, line in ipairs(b) do line.Visible = false end
                        end
                    end

                    if doBox3 then
                        local b = ensureBox3(player)
                        if okPts and allAhead then
                            for i = 1, 12 do
                                local edge = BOX3_EDGES[i]
                                local line = b[i]
                                line.From, line.To, line.Color, line.Visible = pts[edge[1]], pts[edge[2]], col, true
                            end
                        else
                            for _, line in ipairs(b) do line.Visible = false end
                        end
                    end

                    if doTracer then
                        local t = ensureTracer(player)
                        local tx, ty = nil, nil
                        local far = flags.maxDist > 0 and (root.Position - camPos).Magnitude > flags.maxDist
                        if not far then
                            if okPts then
                                tx, ty = (bx1 + bx2) * 0.5, by2
                            else
                                local v = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                                if v.Z > 0 then
                                    tx, ty = v.X, v.Y
                                end
                            end
                        end
                        if tx then
                            t.From, t.To, t.Color, t.Visible = origin, Vector2.new(tx, ty), col, true
                        else
                            t.Visible = false
                        end
                    end

                    if doSkel then
                        local s = ensureSkel(player, character)
                        local rv = camera:WorldToViewportPoint(root.Position)
                        local vp = camera.ViewportSize
                        local onScreen = rv.Z > 0 and rv.X > -250 and rv.X < vp.X + 250
                            and rv.Y > -250 and rv.Y < vp.Y + 250

                        if not onScreen then
                            for i = 1, #s.lines do s.lines[i].Visible = false end
                        else
                            local uq, vx, vy, vok = s.uniq, s.vx, s.vy, s.vok
                            for j = 1, #uq do
                                local part = uq[j]
                                if part.Parent then
                                    local v = camera:WorldToViewportPoint(part.Position)
                                    vx[j], vy[j], vok[j] = v.X, v.Y, v.Z > 0
                                else
                                    vok[j] = false
                                end
                            end
                            for i = 1, #s.bones do
                                local line = s.lines[i]
                                local ja, jb = s.pair[i][1], s.pair[i][2]
                                if ja and jb and vok[ja] and vok[jb] then
                                    line.From = Vector2.new(vx[ja], vy[ja])
                                    line.To = Vector2.new(vx[jb], vy[jb])
                                    line.Color = col
                                    line.Visible = true
                                else
                                    line.Visible = false
                                end
                            end
                        end
                    end
                end
            end
        end
    end

