    local function patchArgs(args, part, isKnife)
        local myRoot = getRoot(LocalPlayer)
        local distance = myRoot and (myRoot.Position - part.Position).Magnitude or 0
        local lead = isKnife and math.clamp(distance / 80, 0.05, 0.4) or 0.06
        local aimPosition = part.Position + part.AssemblyLinearVelocity * lead

        for index = 1, args.n do
            local value = args[index]
            local kind = typeof(value)
            if kind == "Vector3" then
                args[index] = aimPosition
            elseif kind == "CFrame" then
                args[index] = CFrame.lookAt(value.Position, aimPosition)
            end
        end
    end

    local function installSilentHook()
        if silentHooked then
            return true
        end
        if not hookmetamethod or not newcclosure or not getnamecallmethod then
            return false
        end
        silentHooked = true

        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()

            if (silentAim or gunWalls or knifeWalls)
                and isAlive()
                and (method == "InvokeServer" or method == "FireServer")
                and typeof(self) == "Instance"
                and not (checkcaller and checkcaller()) then

                local matched, isKnife = isSilentRemote(self)
                if matched then
                    if isKnife and knifeWalls and patchKnifeThrow then
                        local args = table.pack(...)
                        local ok, patched = pcall(patchKnifeThrow, args)
                        if ok and patched then
                            return oldNamecall(self, table.unpack(args, 1, args.n))
                        end
                    end

                    local wantWalls = gunWalls and not isKnife
                    if wantWalls or silentAim then
                        local ok, part = pcall(silentTarget, wantWalls)
                        if ok and part then
                            local args = table.pack(...)
                            patchArgs(args, part, isKnife)
                            return oldNamecall(self, table.unpack(args, 1, args.n))
                        end
                    end
                end
            end

            return oldNamecall(self, ...)
        end))

        return true
    end

