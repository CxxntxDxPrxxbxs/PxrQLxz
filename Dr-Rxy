					key = input.UserInputType.Name
				end
				if key then
					current = key
					newKey.Bind.Button.Text = key
					listening = false
					if a then a:Disconnect() end
					if func then pcall(func, input) end
					onChanged()
				end
			end)
		end)
		registerFlag(flag, function() return current end, function(v)
