    local function refreshRoles()
        if os.clock() - roleStamp < 1 then
            return
        end
        roleStamp = os.clock()
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local extras = remotes and remotes:FindFirstChild("Extras")
            local getData = extras and extras:FindFirstChild("GetPlayerData")
            if getData then
                local data = getData:InvokeServer()
                if type(data) == "table" then
                    roleData = data
                end
            end
        end)
    end

    local function roleOf(player)
        local entry = roleData and roleData[player.Name]
        if type(entry) == "table" and entry.Role then
            return entry.Role
        end

        local character = player.Character
        local backpack = player:FindFirstChildOfClass("Backpack")
        for _, container in ipairs({ character, backpack }) do
            if container then
                if container:FindFirstChild("Knife") then
                    return "Murderer"
                end
                if container:FindFirstChild("Gun") then
                    return "Sheriff"
                end
            end
        end
        return nil
    end

    local function isDead(player)
        local entry = roleData and roleData[player.Name]
        if type(entry) == "table" and (entry.Dead == true or entry.Killed == true) then
            return true
        end
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        return not humanoid or humanoid.Health <= 0
    end

    local function myRole()
        return roleOf(LocalPlayer)
    end

    local function isGunRole(role)
        return role == "Sheriff" or role == "Hero"
    end

