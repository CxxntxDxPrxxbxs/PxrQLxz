        if type(entry) == "table" and entry.Coins then
            sub = entry.Coins .. "c  ·  " .. sub
        end

        if e._nm ~= nm then
            e._nm = nm
            e.name.Text = nm
            e._nw = nil
        end
        if e._sub ~= sub then
            e._sub = sub
            e.sub.Text = sub
        end
        if e._col ~= col then
            e._col = col
            e.name.TextColor3 = col
            e.edge.Color = col
        end

        local t = math.clamp((dist - 18) / (220 - 18), 0, 1)
        local dim = t * 0.55
        if e._dim ~= dim then
            e._dim = dim
            e.scale.Scale = 1 - (t * 0.45)
            e.card.BackgroundTransparency = 0.2 + dim * 0.5
            e.edge.Transparency = 0.75 + dim * 0.2
            e.name.TextTransparency = dim
            e.sub.TextTransparency = math.min(1, dim * 1.25)
            e.avatar.ImageTransparency = dim
        end

        local wantAvatar = flags.avatar
        if e._av ~= wantAvatar then
            e._av = wantAvatar
            e.avatar.Visible = wantAvatar
            e.name.Position = UDim2.new(0, wantAvatar and 36 or 12, 0.5, 0)
            e._nw = nil
        end

        local key = nm .. sub .. tostring(wantAvatar)
        if e._nw ~= key then
            e._nw = key
            local okN, nz = pcall(function()
                return TextService:GetTextSize(nm, e.name.TextSize, e.name.Font, Vector2.new(4000, 40))
