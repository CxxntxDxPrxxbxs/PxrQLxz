        grabbing = true

        if touchGun(part) then
            Util.notify(L("cb_grabgun"), L("cb_gun_grabbed"), "check")
            grabbing = false
            return true
        end

        local back = root.CFrame

        for _ = 1, 10 do
            local currentRoot = getRoot(LocalPlayer)
            if not (currentRoot and part.Parent) then
                break
            end
            if not canAct() then
                break
            end

            currentRoot.CFrame = CFrame.new(part.Position)
            currentRoot.AssemblyLinearVelocity = Vector3.zero

            if touchGun(part) then
