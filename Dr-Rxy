    local function patchArgs(args, part, isKnife)
        local myRoot = getRoot(LocalPlayer)
        local distance = myRoot and (myRoot.Position - part.Position).Magnitude or 0
        local lead = isKnife and math.clamp(distance / 80, 0.05, 0.4) or 0.06
        local aimPosition = part.Position + part.AssemblyLinearVelocity * lead

        for index = 1, args.n do
            local value = args[index]
            local kind = typeof(value)
            if kind == "Vector3" then
                args[index] = aimPosition
            elseif kind == "CFrame" then
                args[index] = CFrame.lookAt(value.Position, aimPosition)
            end
        end
    end

    local function installSilentHook()
        if silentHooked then
            return true
