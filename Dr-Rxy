local function near(a, b)
	return (math.abs(a.R-b.R) + math.abs(a.G-b.G) + math.abs(a.B-b.B)) < 0.06
end

local function setTheme(main, color2)
	local oldMain, oldAccent = GlobalColor1, GlobalColor2
	local mainRefs = { oldMain, Color3.fromRGB(40,45,62), Color3.fromRGB(39,44,61), Color3.fromRGB(42,42,58) }
	local accentRefs = { oldAccent, Color3.fromRGB(0,255,39), Color3.fromRGB(0,255,38) }
	local function isMain(c) for _, r in ipairs(mainRefs) do if near(c, r) then return true end end return false end
	local function isAccent(c) for _, r in ipairs(accentRefs) do if near(c, r) then return true end end return false end
	for _, v in ipairs(parent:GetDescendants()) do
		pcall(function()
			if v:IsA("GuiObject") then
				if isAccent(v.BackgroundColor3) then
					v.BackgroundColor3 = color2
				elseif isMain(v.BackgroundColor3) then
					v.BackgroundColor3 = main
				end
			elseif v:IsA("UIStroke") then
				if isAccent(v.Color) then v.Color = color2 end
			end
		end)
	end
	GlobalColor1, GlobalColor2 = main, color2
end

