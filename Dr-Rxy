        if not isAlive() then
            aimConn:Disconnect()
            FovGui:Destroy()
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local center = aimCenter(camera)
        local active = aimbot or silentAim or gunWalls
        local part = (aimbot or silentAim) and getAimTarget(camera, center, false) or nil
        local wallPart = gunWalls and getAimTarget(camera, center, true) or nil

        if showFov and active then
            FovCircle.Visible = true
            FovCircle.Size = UDim2.fromOffset(aimFov * 2, aimFov * 2)
            FovCircle.Position = UDim2.fromOffset(center.X, center.Y)
            FovStroke.Color = (part or wallPart) and FOV_LOCKED or FOV_IDLE
        else
            FovCircle.Visible = false
        end

        if not aimbot or not part or not isHolding() then
            return
        end

        local aimPosition = part.Position + part.AssemblyLinearVelocity * 0.05
        local goal = CFrame.lookAt(camera.CFrame.Position, aimPosition)
        camera.CFrame = camera.CFrame:Lerp(goal, math.clamp(aimSmooth / 100, 0.01, 1))
    end)

    local gunEsp = false
    local gunDistance = false
    local gunLoopRunning = false
    local gunEntries = {}

    local function removeGunHighlight(entry)
        if entry.highlight then
            entry.highlight:Destroy()
            entry.highlight = nil
        end
    end

    local function clearGunEntry(target)
        local entry = gunEntries[target]
        if not entry then
            return
        end
        removeGunHighlight(entry)
        if entry.gui then
            entry.gui:Destroy()
        end
        gunEntries[target] = nil
    end

    local function ensureGunHighlight(target, entry)
        if entry.highlight and entry.highlight.Parent then
            return
        end

        local highlight = Instance.new("Highlight")
        highlight.Name = HttpService:GenerateGUID(false)
        highlight.Adornee = target
        highlight.FillColor = Color3.fromRGB(90, 150, 255)
        highlight.FillTransparency = 0.55
        highlight.OutlineColor = Color3.fromRGB(170, 210, 255)
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = target
        entry.highlight = highlight
    end

    local function ensureGunLabel(target, entry)
        if entry.gui and entry.gui.Parent then
            return
        end

        local gui = Instance.new("BillboardGui")
        gui.Name = HttpService:GenerateGUID(false)
        gui.Adornee = target
        gui.Size = UDim2.fromOffset(180, 24)
        gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
        gui.AlwaysOnTop = true
        gui.Parent = target

        local text = Instance.new("TextLabel")
        text.Size = UDim2.fromScale(1, 1)
        text.BackgroundTransparency = 1
        text.Font = Enum.Font.GothamBold
        text.TextSize = 12
        text.TextColor3 = Color3.fromRGB(140, 190, 255)
        text.TextStrokeTransparency = 0.4
        text.Parent = gui

        entry.gui = gui
        entry.text = text
    end

    local function updateGunEsp(scan)
        local found = {}

        for target in pairs(gunEntries) do
            if target.Parent then
                found[target] = true
            end
        end

        if scan then
            for _, object in ipairs(workspace:GetDescendants()) do
                if object:IsA("BasePart") and object.Name == "GunDrop" then
                    found[object] = true
                end
            end
        end

        local root = getRoot(LocalPlayer)

        for target in pairs(found) do
            local entry = gunEntries[target]
            if not entry then
                entry = {}
                gunEntries[target] = entry
            end

            if gunEsp then
                ensureGunHighlight(target, entry)
            else
                removeGunHighlight(entry)
            end

            ensureGunLabel(target, entry)

            local label = gunEsp and "DROPPED GUN" or "GUN"
            if gunDistance and root then
                local distance = math.floor((target.Position - root.Position).Magnitude)
                label = label .. " · " .. distance .. " studs"
            end
            entry.text.Text = label
        end

        for target in pairs(gunEntries) do
            if not found[target] or not target.Parent then
                clearGunEntry(target)
            end
        end
    end

    local function startGunLoop()
        if gunLoopRunning then
            return
        end
        gunLoopRunning = true

        task.spawn(function()
            local tick = 0
            while (gunEsp or gunDistance) and isAlive() do
                pcall(updateGunEsp, tick % 5 == 0)
                tick = tick + 1
                task.wait(0.2)
            end
            for target in pairs(gunEntries) do
                clearGunEntry(target)
            end
            gunLoopRunning = false
        end)
    end

    local GunEspToggle = Combat:Toggle({
        Title = L("cb_gunesp"),
        Desc = L("cb_gunesp_desc"),
        Value = false,
        Callback = function(state)
            gunEsp = state
            if state then
                startGunLoop()
            end
        end,
    })
    Util.register("gun_esp", GunEspToggle)

    local GunDistanceToggle = Combat:Toggle({
        Title = L("cb_gundist"),
        Desc = L("cb_gundist_desc"),
        Value = false,
        Callback = function(state)
            gunDistance = state
            if state then
                startGunLoop()
            end
        end,
    })
    Util.register("gun_esp_distance", GunDistanceToggle)
end

