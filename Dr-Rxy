        silentHooked = true

        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()

            if (silentAim or gunWalls)
                and isAlive()
                and (method == "InvokeServer" or method == "FireServer")
                and typeof(self) == "Instance"
