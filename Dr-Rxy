    local function feedNotify(name, killType, role)
        local tag = ""
        if role then
            tag = " [" .. (role == "Murderer" and "M" or (isGunRole(role) and "S" or "I")) .. "]"
        end
        pcall(function()
            WindUI:Notify({
                Title = L("vs_killfeed_title"),
                Content = tostring(name) .. tag .. "  ·  " .. tostring(killType or L("vs_eliminated")),
                Duration = 4,
                Icon = "skull",
            })
        end)
    end

    local recentKillEvent = {}
    local lastDead = {}

    local function seenRecently(name)
        local seen = recentKillEvent[name]
        return seen ~= nil and os.clock() - seen < 2
    end

    if GameplayR then
        local killEvent = GameplayR:FindFirstChild("KillEvent")
        if killEvent then
            table.insert(connections, killEvent.OnClientEvent:Connect(function(victim, _, _, killType)
                if not victim then
                    return
                end
                local name = tostring(victim)
                recentKillEvent[name] = os.clock()
                if flags.killFeed then
                    local player = Players:FindFirstChild(name)
                    feedNotify(name, killType, player and roleOf(player) or nil)
                end
            end))
        end

        local roundStart = GameplayR:FindFirstChild("RoundStart")
        if roundStart then
            table.insert(connections, roundStart.OnClientEvent:Connect(function()
                lastDead = {}
                recentKillEvent = {}
            end))
        end
    end

    local function scanDeaths()
        local data = (CRC and CRC.PlayerData) or roleData
        if type(data) ~= "table" then
            return
        end
        for name, entry in pairs(data) do
            if type(entry) == "table" then
                local dead = (entry.Dead == true or entry.Killed == true)
                local was = lastDead[name]
                if was == false and dead then
                    if flags.killFeed and not seenRecently(name) then
                        recentKillEvent[name] = os.clock()
                        feedNotify(name, nil, entry.Role)
                    end
                end
                lastDead[name] = dead
            end
        end
    end

    local function watchDeaths(player)
        if player == LocalPlayer then
            return
        end

        local function hookCharacter(character)
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if not humanoid then
                return
            end
            table.insert(connections, humanoid.Died:Connect(function()
                local name = player.Name
                if flags.killFeed and not seenRecently(name) then
                    recentKillEvent[name] = os.clock()
                    feedNotify(player.DisplayName or name, nil, roleOf(player))
                end
            end))
        end

        if player.Character then
            hookCharacter(player.Character)
        end
        table.insert(connections, player.CharacterAdded:Connect(function(character)
            task.defer(hookCharacter, character)
        end))
    end

    for _, player in ipairs(Players:GetPlayers()) do
        watchDeaths(player)
    end
    table.insert(connections, Players.PlayerAdded:Connect(watchDeaths))

    task.spawn(function()
