                if targetRoot and currentRoot then
                    currentRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1.5)
                    currentRoot.AssemblyLinearVelocity = Vector3.zero
                    stab(knife, targetRoot)
