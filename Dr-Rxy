                        local distance = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                        if distance <= bestDistance and (not needVisible or isVisible(camera, part)) then
                            bestPart = part
                            bestDistance = distance
                        end
                    end
                end
            end
        end

        return bestPart
    end

    local function resolveKnifeTarget(instant)
        local camera = workspace.CurrentCamera
        local myRoot = getRoot(LocalPlayer)
        if not (camera and myRoot) then
            return nil
        end
        local center = aimCenter(camera)

        if silentAim or knifeWalls then
            local part = closestPlayerPart(camera, center, not knifeWalls)
            if part then
                local lead = instant and 0.05
                    or math.clamp((myRoot.Position - part.Position).Magnitude / 80, 0.05, 0.4)
                return part.Position + part.AssemblyLinearVelocity * lead
            end
        end

        return mapPoint(camera, center)
    end

    local function knifeOrigin(root, target)
        local direction = target - root.Position
        direction = direction.Magnitude > 0.1 and direction.Unit or Vector3.new(0, 0, -1)
        return CFrame.lookAt(target - direction * KNIFE_BACKOFF, target)
    end

    patchKnifeThrow = function(args)
        local root = getRoot(LocalPlayer)
        local target = resolveKnifeTarget(false)
        if not (root and target) then
            return false
        end
        args[1] = knifeOrigin(root, target)
        args[2] = CFrame.new(target)
        return true
    end

    local function throwKnifeNow()
        local root = getRoot(LocalPlayer)
        if not (instantKnife and isAlive() and root) or isDead(LocalPlayer) then
            return false
        end

        local knife = findWeapon("Knife")
        if not knife then
            return false
        end
        if knife.Parent ~= LocalPlayer.Character then
            equip(knife)
            knife = findWeapon("Knife") or knife
        end

        local events = knife:FindFirstChild("Events")
        local thrown = events and events:FindFirstChild("KnifeThrown")
        if not thrown or knife:GetAttribute("Disabled") == true then
            return false
        end

        local cooldown = 2 * (tonumber(knife:GetAttribute("ThrowSpeed")) or 1)
        if os.clock() - instantFiredAt < cooldown then
            return false
        end

        local target = resolveKnifeTarget(true)
        if not target then
            return false
        end

        instantFiredAt = os.clock()

        local handle = knife:FindFirstChild("Handle")
        local origin
        if knifeWalls or not handle then
            origin = knifeOrigin(root, target)
        else
            origin = handle.CFrame
        end

        pcall(function()
            thrown:FireServer(origin, CFrame.new(target))
        end)
        return true
    end

    local function startKnifeLoop()
        if knifeLoopRunning then
