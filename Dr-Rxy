do
    local PlayerMisc = Tabs.PlayerMisc

    local flags = {
        loopFling = false,
        autoMurderer = false,
        autoSheriff = false,
    }
    local flingPower = 10000
    local flingSeconds = 3
    local targetName = nil

    local connections = {}
    local flinging = false
    local flingAllRunning = false
    local loopGen = 0
    local noclipParts = {}
    local unclipped = {}
    local flungAt = setmetatable({}, { __mode = "k" })

    local FLING_MAX_DY = 140
    local FLING_MAX_RISE = 320
    local canClaim = typeof(sethiddenproperty) == "function"
    local warnedClaim = false

    local function rootOf(player)
        local character = player and player.Character
        return character and character:FindFirstChild("HumanoidRootPart")
    end

    local function myHumanoid()
        local character = LocalPlayer.Character
        return character and character:FindFirstChildOfClass("Humanoid")
    end

    local function hasBody(player)
        local character = player and player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        return humanoid ~= nil and root ~= nil and humanoid.Health > 0
    end

    local function badVec(v)
        if typeof(v) ~= "Vector3" then
            return true
        end
        if v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z then
            return true
        end
        return math.abs(v.X) == math.huge or math.abs(v.Y) == math.huge or math.abs(v.Z) == math.huge
    end

    local function voidY()
        local ok, value = pcall(function()
            return workspace.FallenPartsDestroyHeight
        end)
        return (ok and type(value) == "number") and value or -500
    end

    local function displayOf(player)
        return player.DisplayName ~= "" and player.DisplayName or player.Name
    end

    local roleData = nil
    local roleStamp = 0

    local function refreshRoles()
        if os.clock() - roleStamp < 1 then
            return
        end
        roleStamp = os.clock()
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local extras = remotes and remotes:FindFirstChild("Extras")
            local getData = extras and extras:FindFirstChild("GetPlayerData")
            if getData then
                local data = getData:InvokeServer()
                if type(data) == "table" then
                    roleData = data
                end
            end
        end)
    end

    local function roleOf(player)
        local entry = roleData and roleData[player.Name]
        if type(entry) == "table" and entry.Role then
            return entry.Role
        end
        local backpack = player:FindFirstChildOfClass("Backpack")
        for _, container in ipairs({ player.Character, backpack }) do
            if container then
                if container:FindFirstChild("Knife") then
                    return "Murderer"
                end
                if container:FindFirstChild("Gun") then
                    return "Sheriff"
                end
            end
        end
        return nil
    end

    local function isGunRole(role)
        return role == "Sheriff" or role == "Hero"
    end

    local function isAliveInRound(player)
        local entry = roleData and roleData[player.Name]
        if type(entry) == "table" and (entry.Dead == true or entry.Killed == true) then
            return false
        end
        return hasBody(player)
    end

    local function resolvePlayer(name)
        if type(name) ~= "string" or name == "" then
            return nil
        end
        local exact = Players:FindFirstChild(name)
        if exact and exact:IsA("Player") then
            return exact
        end
        local lowered = name:lower()
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Name:lower() == lowered or player.DisplayName:lower() == lowered then
                return player
            end
        end
        return nil
    end

    local function targetList()
        local list = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                list[#list + 1] = player.Name
            end
        end
        table.sort(list)
        if #list == 0 then
            list[1] = L("pm_nobody")
        end
        return list
    end

    local function targetPlayer()
        local player = resolvePlayer(targetName)
        if player == LocalPlayer then
            return nil
        end
        return player
    end

    local function collectParts()
        table.clear(noclipParts)
        local character = LocalPlayer.Character
        if character then
            for _, descendant in ipairs(character:GetDescendants()) do
                if descendant:IsA("BasePart") then
                    noclipParts[#noclipParts + 1] = descendant
                end
            end
        end
    end

    local function restoreCollisions()
        for part in pairs(unclipped) do
            if part.Parent then
                part.CanCollide = true
            end
        end
        table.clear(unclipped)
    end

    table.insert(connections, RunService.Stepped:Connect(function()
        if not flinging then
            return
        end
        for _, part in ipairs(noclipParts) do
            if part.Parent and part.CanCollide then
                part.CanCollide = false
                unclipped[part] = true
            end
        end
    end))

    local function teleportTo(position)
        local root = rootOf(LocalPlayer)
        if not root then
            return false
        end
        root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
        root.AssemblyLinearVelocity = Vector3.zero
        return true
    end

    local function alreadyFlung(player)
        local root = rootOf(player)
        if not root then
            return true
        end
        if os.clock() - (flungAt[player] or -60) < 4 then
            return true
        end
        if root.AssemblyLinearVelocity.Magnitude > 100 then
            return true
        end
        if root.Position.Y < voidY() + 150 then
            return true
        end
        local mine = rootOf(LocalPlayer)
        if mine then
            local dy = root.Position.Y - mine.Position.Y
            if dy < -60 or dy > 120 then
                return true
            end
        end
        return false
    end

    local function releaseClaim(part)
        if part and canClaim then
            pcall(function()
                sethiddenproperty(part, "PhysicsRepRootPart", nil)
            end)
        end
    end

    local function flingPlayer(player, keepPos)
        if flinging then
            return false, L("pm_err_busy")
        end

        local myRoot = rootOf(LocalPlayer)
        local targetRoot = rootOf(player)
        if not (myRoot and myHumanoid() and targetRoot) then
            return false, L("pm_err_nochar")
        end

        local back = keepPos or myRoot.CFrame
        if math.abs(targetRoot.Position.Y - back.Position.Y) > FLING_MAX_DY then
            return false, L("pm_err_far")
        end
        if targetRoot.AssemblyLinearVelocity.Magnitude > 340 then
            return false, L("pm_err_flying")
        end

        if not canClaim and not warnedClaim then
            warnedClaim = true
            Util.notify(L("pm_actions_section"), L("pm_noclaim"), "triangle-alert")
        end

        flinging = true
        collectParts()

        local moved = false
        local claimed = nil

        -- pcall: pase lo que pase, abajo se limpia el estado
        pcall(function()
            local nudge = 0.1
            local started = os.clock()

            while os.clock() - started < flingSeconds and isAlive() do
                RunService.Heartbeat:Wait()

                local mine = rootOf(LocalPlayer)
                local theirs = rootOf(player)
                if not (mine and theirs and mine.Parent and theirs.Parent) then
                    break
                end

                local y = theirs.Position.Y
                if y < voidY() + 400 then break end
                if theirs.AssemblyLinearVelocity.Magnitude > 340 then break end
                if y > back.Position.Y + FLING_MAX_RISE then break end
                if y < back.Position.Y - FLING_MAX_DY then break end

                mine.CFrame = theirs.CFrame
                moved = true
                flungAt[player] = os.clock()

                if canClaim then
                    pcall(function()
                        sethiddenproperty(mine, "PhysicsRepRootPart", theirs)
                    end)
                    claimed = mine
                end

                local velocity = mine.AssemblyLinearVelocity
                mine.AssemblyLinearVelocity = velocity * flingPower + Vector3.new(0, flingPower, 0)
                RunService.RenderStepped:Wait()
                if not mine.Parent then break end

                mine.AssemblyLinearVelocity = velocity
                RunService.Stepped:Wait()
                if not mine.Parent then break end

                mine.AssemblyLinearVelocity = velocity + Vector3.new(0, nudge, 0)
                nudge = -nudge
            end
        end)

        releaseClaim(claimed)
        local current = rootOf(LocalPlayer)
        if current and current ~= claimed then
            releaseClaim(current)
        end

        if not moved then
            flinging = false
            restoreCollisions()
            return false, L("pm_err_grip")
        end

        local home = CFrame.new(back.Position + Vector3.new(0, 4, 0))
        for _ = 1, 6 do
            local character = LocalPlayer.Character
            if not character then
                break
            end
            for _, descendant in ipairs(character:GetDescendants()) do
                if descendant:IsA("BasePart") then
                    descendant.AssemblyLinearVelocity = Vector3.zero
                    descendant.AssemblyAngularVelocity = Vector3.zero
                end
            end
            RunService.Heartbeat:Wait()
        end

        local settled = rootOf(LocalPlayer)
        if settled then
            settled.CFrame = home
            settled.AssemblyLinearVelocity = Vector3.zero
            settled.AssemblyAngularVelocity = Vector3.zero
        end

        flinging = false
        restoreCollisions()

        local watchStart = os.clock()
        while os.clock() - watchStart < 1.5 and isAlive() do
            RunService.Heartbeat:Wait()
            local root = rootOf(LocalPlayer)
            if not root then
                break
            end
            local lv, av = root.AssemblyLinearVelocity, root.AssemblyAngularVelocity
            if badVec(lv) or badVec(av) or lv.Magnitude > 200 or av.Magnitude > 25 then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = home
            end
        end
        restoreCollisions()

        return true
    end

    local function flingAll()
        if flingAllRunning or flinging then
            return
        end
        local myRoot = rootOf(LocalPlayer)
        if not myRoot then
            Util.notify(L("pm_actions_section"), L("pm_nochar"), "triangle-alert")
            return
        end

        flingAllRunning = true
        local home = myRoot.CFrame

        task.spawn(function()
            local count = 0
            for _, player in ipairs(Players:GetPlayers()) do
                if not isAlive() then
                    break
                end
                if player ~= LocalPlayer and hasBody(player) then
                    if flingPlayer(player, home) then
                        count = count + 1
                    end
                    task.wait(0.1)
                end
            end

            local root = rootOf(LocalPlayer)
            if root then
                root.CFrame = home
                root.AssemblyLinearVelocity = Vector3.zero
            end
            flingAllRunning = false
            Util.notify(L("pm_actions_section"), L("pm_flung_n", count), "check")
        end)
    end

    task.spawn(function()
        while isAlive() do
            if (flags.autoMurderer or flags.autoSheriff)
                and hasBody(LocalPlayer) and not flinging and not flingAllRunning then
                pcall(function()
                    refreshRoles()
                    local want = nil
                    for _, player in ipairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and isAliveInRound(player) then
                            local role = roleOf(player)
                            if ((flags.autoMurderer and role == "Murderer")
                                or (flags.autoSheriff and isGunRole(role)))
                                and not alreadyFlung(player) then
                                want = player
                                break
                            end
                        end
                    end
                    if want then
                        flingPlayer(want)
                    end
                end)
            end
            task.wait(0.5)
        end
    end)

    PlayerMisc:Section({ Title = L("pm_actions_section") })

    local initialList = targetList()
    if initialList[1] ~= L("pm_nobody") then
        targetName = initialList[1]
    end

    local TargetDropdown
    TargetDropdown = PlayerMisc:Dropdown({
        Title = L("pm_target"),
        Desc = L("pm_target_desc"),
        Values = initialList,
        Value = initialList[1],
        Callback = function(option)
            if type(option) == "string" and option ~= L("pm_nobody") then
                targetName = option
            else
                targetName = nil
            end
        end,
    })

    local function refreshTargets()
        task.delay(0.2, function()
            if not isAlive() then
                return
            end
            local list = targetList()
            pcall(function()
                TargetDropdown:Refresh(list)
            end)

            local still = resolvePlayer(targetName)
            if not (still and still ~= LocalPlayer) then
                targetName = (list[1] ~= L("pm_nobody")) and list[1] or nil
                still = resolvePlayer(targetName)
            end
            if still then
                pcall(function()
                    TargetDropdown:Select(still.Name)
                end)
            end
        end)
    end
    table.insert(connections, Players.PlayerAdded:Connect(refreshTargets))
    table.insert(connections, Players.PlayerRemoving:Connect(refreshTargets))

    PlayerMisc:Button({
        Title = L("pm_tp"),
        Desc = L("pm_tp_desc"),
        Icon = "map-pin",
        Callback = function()
            local player = targetPlayer()
            if not player then
                Util.notify(L("pm_tp"), L("pm_pick"), "triangle-alert")
                return
            end
            local root = rootOf(player)
            if not root then
                Util.notify(L("pm_tp"), L("pm_tp_dead", displayOf(player)), "triangle-alert")
                return
            end
            if teleportTo(root.Position) then
                Util.notify(L("pm_tp"), L("pm_tp_ok", displayOf(player)), "check")
            else
                Util.notify(L("pm_tp"), L("pm_nochar"), "triangle-alert")
            end
        end,
    })

    PlayerMisc:Button({
        Title = L("pm_fling"),
        Desc = L("pm_fling_desc"),
        Icon = "wind",
        Callback = function()
            local player = targetPlayer()
            if not player then
                Util.notify(L("pm_fling"), L("pm_pick"), "triangle-alert")
                return
            end
            if not rootOf(player) then
                Util.notify(L("pm_fling"), L("pm_fling_dead", displayOf(player)), "triangle-alert")
                return
            end
            Util.notify(L("pm_fling"), L("pm_flinging", displayOf(player)), "wind")
            task.spawn(function()
                local ok, why = flingPlayer(player)
                if not ok and why then
                    Util.notify(L("pm_fling"), why, "triangle-alert")
                end
            end)
        end,
    })

    local LoopFlingToggle
    LoopFlingToggle = PlayerMisc:Toggle({
        Title = L("pm_loopfling"),
        Desc = L("pm_loopfling_desc"),
        Value = false,
        Callback = function(state)
            flags.loopFling = state
            loopGen = loopGen + 1
            local gen = loopGen

            if not state then
                return
            end

            task.spawn(function()
                local lastWhy = nil
                while flags.loopFling and isAlive() and loopGen == gen do
                    local player = targetPlayer()
                    if not player then
                        Util.notify(L("pm_loopfling"), L("pm_pick"), "triangle-alert")
                        flags.loopFling = false
                        task.defer(function()
                            pcall(function()
                                LoopFlingToggle:Set(false)
                            end)
                        end)
                        break
                    end

                    if hasBody(LocalPlayer) and rootOf(player)
                        and not alreadyFlung(player) and not flinging and not flingAllRunning then
                        local ok, why = flingPlayer(player)
                        if ok then
                            lastWhy = nil
                        elseif why and why ~= lastWhy then
                            lastWhy = why
                            Util.notify(L("pm_loopfling"), why, "triangle-alert")
                        end
                    end
                    task.wait(0.4)
                end
            end)
        end,
    })
    Util.register("loop_fling", LoopFlingToggle)

    PlayerMisc:Button({
        Title = L("pm_flingall"),
        Desc = L("pm_flingall_desc"),
        Icon = "users",
        Callback = flingAll,
    })

    local AutoMurdererToggle = PlayerMisc:Toggle({
        Title = L("pm_auto_murderer"),
        Desc = L("pm_auto_murderer_desc"),
        Value = false,
        Callback = function(state)
            flags.autoMurderer = state
        end,
    })
    Util.register("auto_fling_murderer", AutoMurdererToggle)

    local AutoSheriffToggle = PlayerMisc:Toggle({
        Title = L("pm_auto_sheriff"),
        Desc = L("pm_auto_sheriff_desc"),
        Value = false,
        Callback = function(state)
            flags.autoSheriff = state
        end,
    })
    Util.register("auto_fling_sheriff", AutoSheriffToggle)

    local PowerSlider = PlayerMisc:Slider({
        Title = L("pm_power"),
        Step = 500,
        Value = { Min = 1000, Max = 50000, Default = 10000 },
        Callback = function(value)
            flingPower = tonumber(value) or flingPower
        end,
    })
    Util.register("fling_power", PowerSlider)

    local DurationSlider = PlayerMisc:Slider({
        Title = L("pm_duration"),
        Step = 1,
        Value = { Min = 1, Max = 6, Default = 3 },
        Callback = function(value)
            flingSeconds = tonumber(value) or flingSeconds
        end,
    })
    Util.register("fling_duration", DurationSlider)

    task.spawn(function()
        while isAlive() do
            task.wait(1)
        end

        flags.loopFling = false
        flags.autoMurderer = false
        flags.autoSheriff = false
        loopGen = loopGen + 1
        flinging = false

        for _, connection in ipairs(connections) do
            pcall(function() connection:Disconnect() end)
        end
        pcall(restoreCollisions)
    end)
end

do
    local Settings = Tabs.Settings

    local ConfigManager = Window.ConfigManager
    local configCache = {}
    local currentConfig = "default"
    local newConfigName = ""
    local autoSaveEnabled = false

    local themeNames = {}
    local themesOk, themes = pcall(function()
        return WindUI:GetThemes()
    end)
    if themesOk and type(themes) == "table" then
        for name in pairs(themes) do
            table.insert(themeNames, name)
        end
    end
    if #themeNames == 0 then
        themeNames = { "Sherya", "Dark", "Light" }
    end
    table.sort(themeNames)

    Settings:Section({ Title = L("set_appearance") })

    local ThemeDropdown = Settings:Dropdown({
        Title = L("set_theme"),
        Desc = L("set_theme_desc"),
        Values = themeNames,
        Value = themeName,
        Callback = function(option)
            if type(option) ~= "string" then
                return
            end
            pcall(function()
                WindUI:SetTheme(option)
            end)
        end,
    })
    Util.register("theme", ThemeDropdown)

    local TransparencyToggle = Settings:Toggle({
        Title = L("set_transparency"),
        Desc = L("set_transparency_d"),
        Value = true,
        Callback = function(state)
            pcall(function()
                Window:ToggleTransparency(state)
            end)
        end,
    })
    Util.register("transparency", TransparencyToggle)

    local function getConfig(name)
        if not ConfigManager then
            return nil
        end
        if configCache[name] then
            return configCache[name]
        end
        local config = ConfigManager:CreateConfig(name)
        for flag, element in pairs(Registry) do
            config:Register(flag, element)
        end
        configCache[name] = config
        return config
    end

    local function runConfig(action, name)
        return pcall(function()
            local config = getConfig(name)
            config[action](config)
        end)
    end

    local function getConfigNames()
        local ok, names = pcall(function()
            return ConfigManager:AllConfigs()
        end)
        if ok and type(names) == "table" and #names > 0 then
            return names
        end
        return { "default" }
    end

    Settings:Section({ Title = L("set_configuration") })

    local AutoSaveToggle = Settings:Toggle({
        Title = L("set_autosave"),
        Desc = L("set_autosave_desc"),
        Value = false,
        Callback = function(state)
            autoSaveEnabled = state
        end,
    })
    Util.register("autosave", AutoSaveToggle)

    local ConfigDropdown = Settings:Dropdown({
        Title = L("set_select_config"),
        Values = getConfigNames(),
        Value = currentConfig,
        Callback = function(option)
            if type(option) == "string" then
                currentConfig = option
            end
        end,
    })

    local function refreshConfigs(selectName)
        pcall(function()
            ConfigDropdown:Refresh(getConfigNames())
        end)
        pcall(function()
            ConfigDropdown:Select(selectName)
        end)
    end

    Settings:Input({
        Title = L("set_new_config"),
        Placeholder = L("set_new_config_ph"),
        Value = "",
        Callback = function(text)
            newConfigName = text
        end,
    })

    Settings:Button({
        Title = L("set_create_config"),
        Desc = L("set_create_desc"),
        Callback = function()
            local name = Util.sanitizeName(newConfigName)
            if name == "" then
                Util.notify(L("set_config_title"), L("set_type_name"), "triangle-alert")
                return
            end
            currentConfig = name
            runConfig("Save", name)
            refreshConfigs(name)
            Util.notify(L("set_config_title"), L("set_created", name), "check")
        end,
    })

    Settings:Button({
        Title = L("set_save_config"),
        Callback = function()
            local ok = runConfig("Save", currentConfig)
            Util.notify(
                L("set_config_title"),
                ok and L("set_saved", currentConfig) or L("set_cant_save"),
                ok and "check" or "triangle-alert"
            )
        end,
    })

    Settings:Button({
        Title = L("set_load_config"),
        Callback = function()
            local ok = runConfig("Load", currentConfig)
            Util.notify(
                L("set_config_title"),
                ok and L("set_loaded", currentConfig) or L("set_cant_load"),
                ok and "check" or "triangle-alert"
            )
        end,
    })

    Settings:Button({
        Title = L("set_delete_config"),
        Callback = function()
            local name = currentConfig
            runConfig("Delete", name)
            configCache[name] = nil
            currentConfig = "default"
            refreshConfigs("default")
            Util.notify(L("set_config_title"), L("set_deleted", name), "trash-2")
        end,
    })

    task.spawn(function()
        while task.wait(5) and isAlive() do
            if autoSaveEnabled then
                runConfig("Save", currentConfig)
            end
        end
    end)

    function Util.autoLoad()
        runConfig("Load", currentConfig)
    end
end

if Util.autoLoad then
    task.delay(2, Util.autoLoad)
end

pcall(function()
    Tabs.Home:Select()
end)
