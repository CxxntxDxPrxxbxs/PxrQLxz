                    if wantWalls or silentAim then
                        local ok, part = pcall(silentTarget, wantWalls)
                        if ok and part then
                            local args = table.pack(...)
                            patchArgs(args, part, isKnife)
                            return oldNamecall(self, table.unpack(args, 1, args.n))
                        end
                    end
                end
            end

            return oldNamecall(self, ...)
        end))

        return true
    end

