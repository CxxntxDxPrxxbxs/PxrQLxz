local function fsOK()
	return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

local function ensureFolder()
	if typeof(makefolder) == "function" and typeof(isfolder) == "function" then
		if not isfolder(Config.Folder) then pcall(makefolder, Config.Folder) end
	end
end

local function cfgPath(name)
	return Config.Folder .. "/" .. (name or Config.Name) .. ".json"
end

local function serialize(v)
	local t = typeof(v)
	if t == "Color3" then
		return { __t = "Color3", r = v.R, g = v.G, b = v.B }
	elseif t == "EnumItem" then
		return { __t = "Enum", n = tostring(v) }
	elseif t == "table" then
		local o = {}
		for k, val in pairs(v) do o[k] = serialize(val) end
		return o
	else
		return v
	end
end

local function deserialize(v)
	if type(v) == "table" then
		if v.__t == "Color3" then
			return Color3.new(v.r, v.g, v.b)
		elseif v.__t == "Enum" then
			return v.n
		else
			local o = {}
			for k, val in pairs(v) do if k ~= "__t" then o[k] = deserialize(val) end end
			return o
		end
	else
		return v
	end
end

local function registerFlag(flag, getter, setter)
	if not flag then return end
	Flags[flag] = { Get = getter, Set = setter }
end

local saveConfig, loadConfig, listConfigs
function saveConfig(name)
	if not fsOK() then return false, "No filesystem access." end
	ensureFolder()
	local data = {}
	for flag, o in pairs(Flags) do
		local ok, val = pcall(o.Get)
		if ok then data[flag] = serialize(val) end
	end
	local ok, enc = pcall(function()
		return HttpService:JSONEncode({ flags = data, autoSave = Config.AutoSave })
	end)
	if not ok then return false, "Encode failed." end
	local ok2 = pcall(writefile, cfgPath(name), enc)
	return ok2
end

function loadConfig(name)
	if not fsOK() then return false, "No filesystem access." end
	local p = cfgPath(name)
	if not isfile(p) then return false, "Config not found." end
	local ok, raw = pcall(readfile, p)
	if not ok then return false, "Read failed." end
	local ok2, dec = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok2 or type(dec) ~= "table" then return false, "Decode failed." end
	if type(dec.autoSave) == "boolean" then Config.AutoSave = dec.autoSave end
	if dec.flags then
		for flag, sval in pairs(dec.flags) do
			local o = Flags[flag]
			if o then pcall(o.Set, deserialize(sval)) end
		end
	end
	return true
end

function listConfigs()
	local out = {}
	if typeof(listfiles) == "function" then
		local ok, files = pcall(listfiles, Config.Folder)
		if ok then
			for _, f in ipairs(files) do
				local n = tostring(f):match("([^/\\]+)%.json$")
				if n then table.insert(out, n) end
			end
		end
	end
	return out
end

local autoSaveQueued = false
local function onChanged()
	if Config.AutoSave and fsOK() and not autoSaveQueued then
		autoSaveQueued = true
		task.defer(function()
			autoSaveQueued = false
			pcall(saveConfig, Config.Name)
		end)
	end
end

