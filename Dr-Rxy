function Logger.getExecutions()
    local request = Logger.getRequest()
    if not request then
        return 0
    end

    local ok, response = pcall(function()
        return request({
            Url = Config.CounterUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = "{}",
        })
    end)
    if not ok or type(response) ~= "table" then
