    local bodyCache = setmetatable({}, { __mode = "k" })
    local boundsCache = setmetatable({}, { __mode = "k" })

    local function bodyParts(character)
        local entry = bodyCache[character]
        if not entry then
            entry = { dirty = true, list = {} }
            bodyCache[character] = entry
            local function soil()
                entry.dirty = true
            end
            character.ChildAdded:Connect(soil)
            character.ChildRemoved:Connect(soil)
        end
        if entry.dirty then
            table.clear(entry.list)
            for _, child in ipairs(character:GetChildren()) do
                if child:IsA("BasePart") then
                    entry.list[#entry.list + 1] = child
                end
            end
            entry.dirty = false
        end
        return entry.list
    end

    local function charBounds(character)
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then
            return nil
        end
        local base = root.CFrame
        local minX, minY, minZ = math.huge, math.huge, math.huge
        local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
        local found = false

        local body = bodyParts(character)
        for i = 1, #body do
            local part = body[i]
            if part.Parent then
                local rel = base:PointToObjectSpace(part.Position)
                local h = part.Size * 0.5
                local r = math.max(h.X, h.Y, h.Z)
                if rel.X - h.X < minX then minX = rel.X - h.X end
                if rel.X + h.X > maxX then maxX = rel.X + h.X end
                if rel.Y - h.Y < minY then minY = rel.Y - h.Y end
                if rel.Y + h.Y > maxY then maxY = rel.Y + h.Y end
                if rel.Z - r < minZ then minZ = rel.Z - r end
                if rel.Z + r > maxZ then maxZ = rel.Z + r end
                found = true
            end
        end

        if not found then
            return base, Vector3.new(4, 6, 2)
        end

        local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
        local offset = Vector3.new((minX + maxX) * 0.5, (minY + maxY) * 0.5, (minZ + maxZ) * 0.5)

        local prev = boundsCache[character]
        if prev then
            size = prev.size:Lerp(size, 0.25)
            offset = prev.off:Lerp(offset, 0.25)
            prev.size, prev.off = size, offset
        else
            boundsCache[character] = { size = size, off = offset }
        end

        return base * CFrame.new(offset), size
    end

    local function tracerOrigin(camera)
        local vp = camera.ViewportSize
        local from = flags.tracerFrom
        if from == "Top" then
            return Vector2.new(vp.X * 0.5, 0)
        elseif from == "Center" then
            return Vector2.new(vp.X * 0.5, vp.Y * 0.5)
        elseif from == "Bottom Left" then
            return Vector2.new(0, vp.Y)
        elseif from == "Bottom Right" then
            return Vector2.new(vp.X, vp.Y)
        elseif from == "Mouse" then
            local m = UserInputService:GetMouseLocation()
            return Vector2.new(m.X, m.Y)
        end
        return Vector2.new(vp.X * 0.5, vp.Y)
    end

