    local function applyFrameLine(line)
        local frame = rawget(line, "_f")
        if not (frame and frame.Parent) then
            return
        end
        local a, b = rawget(line, "_From"), rawget(line, "_To")
        if not (a and b) then
            return
        end
        local d = b - a
        frame.Position = UDim2.fromOffset((a.X + b.X) * 0.5, (a.Y + b.Y) * 0.5)
        frame.Size = UDim2.fromOffset(math.max(d.Magnitude, 1), math.max(rawget(line, "_Thickness") or 1, 1))
        frame.Rotation = math.deg(math.atan2(d.Y, d.X))
    end

    lineMeta.__index = function(t, key)
        if key == "Remove" then
            return function(self)
                local frame = rawget(self, "_f")
                if frame then
