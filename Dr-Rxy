            end)
            local nw = okN and nz.X or (#nm * 8)
            local sw = okS and sz.X or (#sub * 6)
            local left = wantAvatar and 36 or 12
            local width = math.clamp(math.ceil(left + nw + 14 + sw + 10), 150, 520)
            e.name.Size = UDim2.fromOffset(math.ceil(nw) + 2, 15)
            e.sub.Size = UDim2.fromOffset(math.ceil(sw) + 2, 14)
            e.card.Size = UDim2.fromOffset(width, 32)
            e.bb.Size = UDim2.fromOffset(width, 40)
