            RunService.Heartbeat:Wait()
        end

        local finalRoot = getRoot(LocalPlayer)
        if finalRoot then
            finalRoot.CFrame = back
            finalRoot.AssemblyLinearVelocity = Vector3.zero
        end

        local got = findWeapon("Gun") ~= nil
