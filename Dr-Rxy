    end

    local function equipPunch()
        local character, humanoid = getCharacter(LocalPlayer)
        if not character then
            return nil
        end
        local punch = getPunch()
        if punch and punch.Parent ~= character then
            pcall(function()
                humanoid:EquipTool(punch)
            end)
