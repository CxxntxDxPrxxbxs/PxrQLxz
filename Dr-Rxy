    local function freshCoins()
        local out = {}
        local tagged = CollectionService:GetTagged("ServerCoinPart")

        if #tagged > 0 then
            for _, part in ipairs(tagged) do
                if part:IsA("BasePart") and part.Parent and not coinTaken(part) then
                    out[#out + 1] = part
                end
            end
            return out
        end

        local container = getCoinContainer()
        if container then
            for _, part in ipairs(container:GetChildren()) do
                if part:IsA("BasePart")
                    and (part:GetAttribute("CoinID") ~= nil or part.Name == "Coin_Server")
                    and not coinTaken(part) then
                    out[#out + 1] = part
                end
            end
        end
        return out
    end

    local coinCache = {}
    local coinEspStore = {}

    task.spawn(function()
        while isAlive() do
