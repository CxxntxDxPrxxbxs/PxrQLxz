            local now = os.clock()
            if now >= nextAttack then
                local punch = equipPunch()
                if punch then
                    local attackTime = punch:FindFirstChild("attackTime")
                    nextAttack = now + (attackTime and math.max(0.1, attackTime.Value) or 0.35)
