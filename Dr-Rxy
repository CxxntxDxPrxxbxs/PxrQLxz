                end
            end
        end
        return rawget(t, "_" .. key)
    end

    lineMeta.__newindex = function(t, key, value)
        rawset(t, "_" .. key, value)
        local frame = rawget(t, "_f")
        if not (frame and frame.Parent) then
            return
        end
        if key == "Visible" then
            frame.Visible = (value == true)
        elseif key == "Color" then
            frame.BackgroundColor3 = value
        elseif key == "From" or key == "To" or key == "Thickness" then
